{
  "expo": {
    "name": "Mes Finances",
    "slug": "mes-finances",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mesfinances",
    "userInterfaceStyle": "light",
    "ios": {},
    "android": {
      "package": "ci.mesfinances.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E183B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E183B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1E183B"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Mes Finances utilise Face ID pour protéger l’accès à votre budget."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
